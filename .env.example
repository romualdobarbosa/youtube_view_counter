# Chave da YouTube Data API v3 (Google Cloud Console > APIs & Services > Credentials).
YOUTUBE_API_KEY=

# Store da ingestão de podcasts: "local" (arquivo data/youtube.db, padrão) ou
# "turso" (banco gerenciado libSQL — necessário pra rodar via GitHub Actions,
# já que o runner é efêmero). TURSO_DATABASE_URL/TURSO_AUTH_TOKEN só valem
# quando DB_BACKEND=turso (turso db create ... / turso db tokens create ...).
DB_BACKEND=local
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
